{
    "name": "bitdreamit/laravel-biometric-attendance",
    "description": "ZKTeco biometric attendance — devices, employees, shifts, leave, reports, bidirectional sync",
    "type": "library",
    "license": "MIT",
    "keywords": ["laravel","zkteco","biometric","attendance","fingerprint","face","rfid"],
    "authors": [{"name":"bitdreamit","email":"hello@bitdreamit.com"}],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/database": "^10.0|^11.0",
        "illuminate/routing": "^10.0|^11.0",
        "illuminate/http": "^10.0|^11.0",
        "illuminate/console": "^10.0|^11.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {"Bitdreamit\\BiometricAttendance\\": "src/"}
    },
    "autoload-dev": {
        "psr-4": {"Bitdreamit\\BiometricAttendance\\Tests\\": "tests/"}
    },
    "extra": {
        "laravel": {
            "providers": ["Bitdreamit\\BiometricAttendance\\BiometricAttendanceServiceProvider"],
            "aliases":   {"Biometric": "Bitdreamit\\BiometricAttendance\\Facades\\Biometric"}
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
